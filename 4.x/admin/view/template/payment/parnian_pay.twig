{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <div class="alert alert-info">{{ text_intro }}</div>
        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <fieldset>
            <legend>{{ text_connection }}</legend>
            <div class="row mb-3 required">
              <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
              <div class="col-sm-10">
                <input type="password" name="payment_parnian_pay_api_key" value="{{ payment_parnian_pay_api_key }}" placeholder="pk_live_..." id="input-api-key" class="form-control" autocomplete="off" dir="ltr"/>
                <div id="error-api-key" class="invalid-feedback"></div>
                <div class="form-text">{{ help_api_key }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-webhook-secret" class="col-sm-2 col-form-label">{{ entry_webhook_secret }}</label>
              <div class="col-sm-10">
                <input type="password" name="payment_parnian_pay_webhook_secret" value="{{ payment_parnian_pay_webhook_secret }}" placeholder="whsec_..." id="input-webhook-secret" class="form-control" autocomplete="off" dir="ltr"/>
                <div class="form-text">{{ help_webhook_secret }}<br>{{ text_webhook_help }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-gateway-url" class="col-sm-2 col-form-label">{{ entry_gateway_url }}</label>
              <div class="col-sm-10">
                <input type="url" name="payment_parnian_pay_gateway_url" value="{{ payment_parnian_pay_gateway_url }}" id="input-gateway-url" class="form-control" dir="ltr"/>
                <div class="form-text">{{ help_rates }}</div>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_order_statuses }}</legend>
            {% for f in ['pending', 'paid', 'expired', 'review'] %}
              {% set key = 'payment_parnian_pay_' ~ f ~ '_status_id' %}
              <div class="row mb-3">
                <label for="input-{{ f }}" class="col-sm-2 col-form-label">{{ attribute(_context, 'entry_status_' ~ f) }}</label>
                <div class="col-sm-10">
                  <select name="{{ key }}" id="input-{{ f }}" class="form-select">
                    {% for order_status in order_statuses %}
                      <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == attribute(_context, key) %} selected{% endif %}>{{ order_status.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
            {% endfor %}
          </fieldset>
          <fieldset>
            <legend>{{ text_general }}</legend>
            <div class="row mb-3">
              <label for="input-expires" class="col-sm-2 col-form-label">{{ entry_expires }}</label>
              <div class="col-sm-10"><input type="number" min="5" max="1440" name="payment_parnian_pay_expires" value="{{ payment_parnian_pay_expires }}" id="input-expires" class="form-control"/></div>
            </div>
            <div class="row mb-3">
              <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
              <div class="col-sm-10">
                <select name="payment_parnian_pay_geo_zone_id" id="input-geo-zone" class="form-select">
                  <option value="0">{{ text_all_zones }}</option>
                  {% for geo_zone in geo_zones %}
                    <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_parnian_pay_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_debug }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="payment_parnian_pay_debug" value="0"/>
                  <input type="checkbox" name="payment_parnian_pay_debug" value="1" id="input-debug" class="form-check-input"{% if payment_parnian_pay_debug %} checked{% endif %}/>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="payment_parnian_pay_status" value="0"/>
                  <input type="checkbox" name="payment_parnian_pay_status" value="1" id="input-status" class="form-check-input"{% if payment_parnian_pay_status %} checked{% endif %}/>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
              <div class="col-sm-10"><input type="text" name="payment_parnian_pay_sort_order" value="{{ payment_parnian_pay_sort_order }}" id="input-sort-order" class="form-control"/></div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
