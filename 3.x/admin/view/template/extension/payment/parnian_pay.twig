{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-payment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% for w in warnings %}
    <div class="alert alert-{{ w.type }}">{{ w.text }}</div>
    {% endfor %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <div class="alert alert-info">{{ text_intro }}</div>
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment" class="form-horizontal">
          <fieldset>
            <legend>{{ text_connection }}</legend>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-api-key"><span data-toggle="tooltip" title="{{ help_api_key }}">{{ entry_api_key }}</span></label>
              <div class="col-sm-10">
                <input type="password" name="payment_parnian_pay_api_key" value="{{ payment_parnian_pay_api_key }}" placeholder="pk_live_..." id="input-api-key" class="form-control" autocomplete="off" dir="ltr" />
                {% if error_api_key %}<div class="text-danger">{{ error_api_key }}</div>{% endif %}
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-webhook-secret"><span data-toggle="tooltip" title="{{ help_webhook_secret }}">{{ entry_webhook_secret }}</span></label>
              <div class="col-sm-10">
                <input type="password" name="payment_parnian_pay_webhook_secret" value="{{ payment_parnian_pay_webhook_secret }}" placeholder="whsec_..." id="input-webhook-secret" class="form-control" autocomplete="off" dir="ltr" />
                <p class="help-block">{{ text_webhook_help }}</p>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-gateway-url">{{ entry_gateway_url }}</label>
              <div class="col-sm-10">
                <input type="url" name="payment_parnian_pay_gateway_url" value="{{ payment_parnian_pay_gateway_url }}" id="input-gateway-url" class="form-control" dir="ltr" />
              </div>
            </div>
            <div class="form-group">
              <div class="col-sm-offset-2 col-sm-10"><p class="help-block">{{ help_rates }}</p></div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_order_statuses }}</legend>
            {% for f in ['pending', 'paid', 'expired', 'review'] %}
            {% set key = 'payment_parnian_pay_' ~ f ~ '_status_id' %}
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-{{ f }}">{{ attribute(_context, 'entry_status_' ~ f) }}</label>
              <div class="col-sm-10">
                <select name="{{ key }}" id="input-{{ f }}" class="form-control">
                  {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == attribute(_context, key) %} selected="selected"{% endif %}>{{ order_status.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            {% endfor %}
          </fieldset>
          <fieldset>
            <legend>{{ text_general }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-expires">{{ entry_expires }}</label>
              <div class="col-sm-10">
                <input type="number" min="5" max="1440" name="payment_parnian_pay_expires" value="{{ payment_parnian_pay_expires }}" id="input-expires" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-geo-zone">{{ entry_geo_zone }}</label>
              <div class="col-sm-10">
                <select name="payment_parnian_pay_geo_zone_id" id="input-geo-zone" class="form-control">
                  <option value="0">{{ text_all_zones }}</option>
                  {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_parnian_pay_geo_zone_id %} selected="selected"{% endif %}>{{ geo_zone.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-debug">{{ entry_debug }}</label>
              <div class="col-sm-10">
                <select name="payment_parnian_pay_debug" id="input-debug" class="form-control">
                  <option value="0"{% if not payment_parnian_pay_debug %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                  <option value="1"{% if payment_parnian_pay_debug %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="payment_parnian_pay_status" id="input-status" class="form-control">
                  <option value="1"{% if payment_parnian_pay_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not payment_parnian_pay_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
              <div class="col-sm-10">
                <input type="text" name="payment_parnian_pay_sort_order" value="{{ payment_parnian_pay_sort_order }}" id="input-sort-order" class="form-control" />
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
